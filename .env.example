# Copie para .env.production (ou configure na Vercel em Settings → Environment Variables).
# Estas chaves são públicas por natureza: a segurança vem do login e das regras do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
VITE_NOME_GABINETE=Gabinete do Deputado Fulano
VITE_DEPUTADO=deputado Fulano
# Opcional – Google Agenda
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CALENDAR_ID=primary
